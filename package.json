{
  "name": "companyos",
  "version": "0.0.0",
  "private": true,
  "description": "CompanyOS V1.1 — local-first, desktop AI-company operating system. Sprint 0 foundation (P0).",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "boundaries": "node scripts/check-boundaries.mjs",
    "check:workspace": "node scripts/check-workspace.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:scripts": "node --test \"scripts/tests/**/*.test.mjs\"",
    "test:architecture": "node scripts/check-architecture.mjs",
    "test:provider:dsh:live": "vitest run --config vitest.provider-live.config.ts",
    "test:kernel": "vitest run --config vitest.kernel.config.ts",
    "build": "pnpm run build:libs && pnpm run build:renderer && pnpm run build:desktop",
    "build:libs": "tsc -b tsconfig.build.json",
    "build:renderer": "pnpm --filter @companyos/renderer build",
    "build:desktop": "pnpm --filter @companyos/desktop build",
    "check": "node scripts/check.mjs",
    "clean": "node scripts/clean.mjs",
    "dev": "pnpm --filter @companyos/desktop dev",
    "test:sandbox": "vitest run --config vitest.kernel.config.ts tests/sandbox-lab",
    "test:hardened-security-research": "vitest run --config vitest.hardened-research.config.ts",
    "test:stage6": "vitest run apps/desktop/tests/stage6-model-pool.test.ts",
    "test:stage7": "vitest run apps/desktop/tests/stage7-role-orchestration.test.ts",
    "test:stage8": "vitest run apps/desktop/tests/stage8-role-collaboration.test.ts apps/desktop/tests/stage8-smart-routing.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^3.2.7"
  }
}
