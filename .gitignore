# committed on purpose — the deterministic tests need it on a fresh clone).
!tests/fixtures/broker-test-*.pem
*.key
*.p12
*.pfx

# --- editor / os ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# --- scratch ---
.planning/probe.cjs
.tmp/
tmp/
