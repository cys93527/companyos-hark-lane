; CompanyOS Hark lane — Simplified Chinese messages for the Inno Setup 6 wizard.
; Authored in-repo (H12c fallback): the GitHub windows runner's Inno Setup ships no
; ChineseSimplified.isl and nothing is downloaded. Layered OVER compiler:Default.isl
; (MessagesFile: "compiler:Default.isl,ChineseSimplified.isl"), so any message not
; translated here falls back to the English default instead of breaking the build.
; Encoding: UTF-8 with BOM (required by Inno Setup for non-ASCII .isl files).

[LangOptions]
LanguageName=<7B80><4F53><4E2D><6587>
LanguageID=$0804
LanguageCodePage=936

[Messages]
